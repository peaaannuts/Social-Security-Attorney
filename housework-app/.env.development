# Local emulator dev config — no real Firebase project needed.
# "demo-" prefixed project IDs are treated specially by the Firebase Emulator
# Suite: it never tries to reach real Google servers for them.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-housework-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-housework-app
VITE_FIREBASE_STORAGE_BUCKET=demo-housework-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

VITE_USE_EMULATOR=true
